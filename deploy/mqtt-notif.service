# mqtt-notif — unité systemd du service résident.
# Les chemins des Environment= ci-dessous sont des EXEMPLES pour la machine
# dédiée (/etc/mqtt-notif/, /var/lib/mqtt-notif/) : adaptez-les au déploiement
# réel (voir deploy/README.md). Le démon ne code aucun chemin en dur pour sa
# configuration — il lit MQTT_NOTIF_CONFIG et MQTT_NOTIF_FIREBASE_CREDENTIALS
# au démarrage. Seuls ExecStart/Documentation pointent le répertoire
# d'application installé (/opt/mqtt-notif, posé par deploy/install.sh) —
# cohérence épinglée par tests/test_deploy.py.

[Unit]
Description=MQTT to FCM notification bridge
Documentation=file:///opt/mqtt-notif/deploy/README.md
# Limites de démarrage ACTIVES et calibrées avec RestartSec=5 ci-dessous :
# cinq démarrages espacés de 5 s tiennent dans la fenêtre d'une minute, la
# limite déclenche réellement et systemd marque l'unité failed — l'échec de
# démarrage (YAML absent, service-account manquant) reste visible dans
# journald, pas de boucle de redémarrage silencieuse indéfinie. Les défauts
# systemd (5 démarrages / 10 s) ne déclencheraient jamais avec RestartSec=5.
# Réglage de déploiement : ajustable (voir deploy/README.md).
StartLimitBurst=5
StartLimitIntervalSec=1min
# Le démon se reconnecte de lui-même au broker : attendre le réseau au
# démarrage évite seulement la première salve de reconnexions journalisée.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Utilisateur dédié non-root, créé par deploy/install.sh — cross-pinné avec
# SERVICE_USER du script par tests/test_deploy.py.
User=mqtt-notif
Group=mqtt-notif
# Chemins d'exemple de la machine dédiée — à adapter au déploiement.
Environment=MQTT_NOTIF_CONFIG=/etc/mqtt-notif/mqtt-notif.yaml
Environment=MQTT_NOTIF_FIREBASE_CREDENTIALS=/var/lib/mqtt-notif/service-account.json
# Console script du venv installé par deploy/install.sh (entrée pyproject :
# mqtt-notif = mqtt_notif.main:main — cross-pinné par tests/test_deploy.py).
ExecStart=/opt/mqtt-notif/.venv/bin/mqtt-notif
# kill -9 du processus -> relance par systemd ; les fenêtres de debounce
# repartent à zéro (QoS 0, aucun rejeu, comportement assumé).
Restart=on-failure
RestartSec=5
# Pas de fichier de log propre : stdout/stderr -> journald par défaut,
# lisible via `journalctl -u mqtt-notif` (timestamps ISO 8601 UTC du démon).
# systemctl stop -> SIGTERM -> déconnexion propre du broker, exit 0,
# état inactive (pas failed).

[Install]
WantedBy=multi-user.target
